# Storage backend (mock | sqlite | postgres)
FLAMEE_STORAGE=mock

# AI provider (mock | openai | anthropic)
FLAMEE_AI=mock

# Seed mock data on startup
FLAMEE_SEED=true

# JWT
FLAMEE_SECRET_KEY=dev-secret-change-in-prod-min-32-bytes-please-longer-key
FLAMEE_JWT_TTL_HOURS=24

# OTP & invite code TTL
FLAMEE_OTP_TTL_SECONDS=600
FLAMEE_INVITE_CODE_TTL_HOURS=168

# Mock persistence file
FLAMEE_MOCK_DATA_FILE=./mock/data.json

# Upload limits
FLAMEE_MAX_UPLOAD_SIZE_MB=5

# Server
FLAMEE_HOST=0.0.0.0
FLAMEE_PORT=8000