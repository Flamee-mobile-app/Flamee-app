# =============================================================================
# Flamee Backend .env example
# Copy file này thành .env và điền giá trị thật.
# =============================================================================

# ----- Server -----
FLAMEE_HOST=0.0.0.0
FLAMEE_PORT=8000
FLAMEE_DEBUG=true
# Danh sách origin CORS được phép, phân tách bằng dấu phẩy
FLAMEE_CORS_ORIGINS=*

# ----- Supabase -----
FLAMEE_SUPABASE_URL=
FLAMEE_SUPABASE_KEY=
FLAMEE_SUPABASE_SERVICE_KEY=

# ----- Auth / Security -----
# Tối thiểu 32 ký tự trong production. KHÔNG dùng giá trị mặc định khi DEBUG=false.
FLAMEE_SECRET_KEY=change-in-production-min-32-chars
FLAMEE_JWT_TTL_HOURS=24
FLAMEE_JWT_REFRESH_TTL_DAYS=30
FLAMEE_OTP_TTL_SECONDS=600
# Theo PRD là 72 giờ
FLAMEE_INVITE_CODE_TTL_HOURS=72

# ----- AI provider -----
# FLAMEE_AI_PROVIDER=openai   # hoặc "gemini"
FLAMEE_AI_PROVIDER=openai
FLAMEE_AI_CHAT_MODEL=gpt-4o-mini
FLAMEE_AI_EMBED_MODEL=text-embedding-3-small
FLAMEE_AI_TIMEOUT_SECONDS=30

# OpenAI (bắt buộc nếu FLAMEE_AI_PROVIDER=openai)
FLAMEE_OPENAI_API_KEY=
FLAMEE_OPENAI_BASE_URL=https://api.openai.com

# Google Gemini (bắt buộc nếu FLAMEE_AI_PROVIDER=gemini)
# Lấy API key tại https://aistudio.google.com/app/apikey
FLAMEE_GEMINI_API_KEY=
FLAMEE_GEMINI_MODEL=gemini-1.5-flash
FLAMEE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Google OAuth - Client ID (verify aud của ID token). BẮT BUỘC trong production.
FLAMEE_GOOGLE_OAUTH_CLIENT_ID=

# Payment webhook secret (HMAC SHA-256). BẮT BUỘC nếu bật webhook.
FLAMEE_PAYMENT_WEBHOOK_SECRET=

# ----- Upload (Memory/Storage) -----
FLAMEE_MAX_UPLOAD_SIZE_MB=10
FLAMEE_MEMORY_BUCKET=memories
# TTL cho signed URL (giây) — 15 phút theo PRD
FLAMEE_IMAGE_SIGN_TTL_SECONDS=900
# Thời gian giữ couple đã break_up trước khi xóa (ngày)
FLAMEE_COUPLE_RETENTION_DAYS=30
