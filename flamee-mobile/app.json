{
  "expo": {
    "name": "Flamee",
    "slug": "flamee-mobile",
    "scheme": "flamee",
    "version": "1.0.0",
    "icon": "./src/features/startup/assets/flamee-symbol.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.flamee.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Flamee chọn ảnh khi bạn chia sẻ một khoảnh khắc.",
          "cameraPermission": "Cho phép Flamee chụp ảnh khi bạn tạo một khoảnh khắc.",
          "microphonePermission": "Cho phép Flamee thu âm khi bạn tạo một khoảnh khắc."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Flamee thu âm khi bạn tạo một khoảnh khắc."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#24110F",
          "dark": {
            "backgroundColor": "#24110F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
