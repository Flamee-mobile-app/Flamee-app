# On EC2: /home/ec2-user/flamee/backend.env. Do not commit real values.
FLAMEE_DEBUG=false
FLAMEE_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FLAMEE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
FLAMEE_SUPABASE_KEY=REPLACE_WITH_ANON_KEY
FLAMEE_SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
FLAMEE_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
FLAMEE_AI_PROVIDER=openai
